---
import { getCollection } from "astro:content";
import SiteLayout from "../components/SiteLayout.astro";
import "../styles/global.css";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const grouped = posts.reduce((years, post) => {
  const year = post.data.pubDate.getFullYear();
  if (!years.has(year)) years.set(year, []);
  years.get(year)!.push(post);
  return years;
}, new Map<number, typeof posts>());
---
<SiteLayout title="Archives" active="archives">
  <h1 class="dynamic-title">Archives</h1>
  <ul id="archives">
    {[...grouped.entries()].map(([year, yearPosts]) => (
      <>
        <h3>{year}</h3>
        {yearPosts.map((post) => (
          <li>
            <span class="archive-date">
              <img class="icon meta-icon" src="/icons/calendar.svg" alt="" aria-hidden="true" />
              {post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
            </span>
            <a href={`/${post.id}`}>{post.data.title}</a>
            {post.data.topic && (
              <span class="archive-category">
                <img class="icon meta-icon" src="/icons/folder.svg" alt="" aria-hidden="true" />
                {post.data.topic}
              </span>
            )}
          </li>
        ))}
      </>
    ))}
  </ul>
</SiteLayout>
