---
import { getCollection } from "astro:content";
import "../../../styles/global.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  // Group by topic
  const topicMap = new Map<string, typeof posts>();
  posts.forEach((post) => {
    const topic = post.data.topic ?? "Uncategorized";
    if (!topicMap.has(topic)) topicMap.set(topic, []);
    topicMap.get(topic)!.push(post);
  });

  return [...topicMap.entries()].map(([topic, topicPosts]) => ({
    params: { topic },
    props: {
      topic,
      posts: topicPosts.sort(
        (a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime()
      ),
    },
  }));
}

const { topic, posts } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{topic}</title>
</head>
<body>
  <nav><a href="/xK9m2p/">&larr; Home</a></nav>
  <h1>{topic}</h1>
  <p class="subtitle">{posts.length} notes</p>

  <ul class="post-list">
    {posts.map((post, i) => (
      <li>
        <a href={`/xK9m2p/${post.id}`}>
          <span class="post-num">{i + 1}</span>
          <span>{post.data.title}</span>
        </a>
      </li>
    ))}
  </ul>
</body>
</html>
