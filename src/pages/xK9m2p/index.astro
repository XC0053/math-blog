---
import { getCollection } from "astro:content";
import "../../styles/global.css";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Group posts by topic
const topicMap = new Map<string, typeof posts>();
posts.forEach((post) => {
  const topic = post.data.topic ?? "Uncategorized";
  if (!topicMap.has(topic)) topicMap.set(topic, []);
  topicMap.get(topic)!.push(post);
});
const topics = [...topicMap.entries()].sort(([a], [b]) => a.localeCompare(b));
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Xiaorui's Blog</title>
</head>
<body>
  <header class="hero">
    <img src="/banner.svg" alt="" class="hero-banner" />
    <h1>Xiaorui's Blog</h1>
    <p class="subtitle">{posts.length} notes in {topics.length} topics</p>
  </header>

  <!-- Topic grid -->
  <div class="post-grid">
    {topics.map(([topic, topicPosts]) => (
      <a class="post-card" href={`/xK9m2p/topics/${topic}`}>
        <div class="post-card-title">{topic}</div>
        <div class="post-card-desc">{topicPosts.length} notes</div>
      </a>
    ))}
  </div>
</body>
</html>
